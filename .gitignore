node_modules/
.DS_Store
*.log

# Wrangler's login cache lands here and holds a real Cloudflare account id.
# This repository is public and its first commit was a `git add -A`.
.wrangler

# The submodules keep their own env files behind their own .gitignore, and this
# repo stores each as a commit SHA rather than a tree, so nothing leaks through
# them. This line is for anything that lands at the root.
.env*

CLAUDE.local.md

# Planning documents, whatever they get called. gitignore has no case-insensitive
# match, so the classes spell it out: AI_PLAN.md, plan.md, R1-Plan.md all land here.
# Scoped to markdown deliberately — an unscoped `*[Pp][Ll][Aa][Nn]*` would also
# swallow source files, and `starter/src/workspace/install-plan.ts` is one.
*[Pp][Ll][Aa][Nn]*.md
